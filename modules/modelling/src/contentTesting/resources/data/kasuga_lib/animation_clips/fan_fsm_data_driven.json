{
  "animation_clips": [
    {
      "id": "kasuga_lib:fan_fsm_data_driven",
      "duration_seconds": 12.0,
      "formula_transforms": [
        {
          "target": { "bone": "group" },
          "transform": { "rotate": { "y": "query.angle" } }
        },
        {
          "target": { "bone": "fan" },
          "transform": { "rotate": { "y": "11 * query.angle" } }
        },
        {
          "target": { "bone": "cover" },
          "transform": { "rotate": { "z": "sin(rad(2 * query.angle)) * 30" } }
        }
      ]
    }
  ]
}
